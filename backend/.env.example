# Copy to backend/.env and fill in your own values. Never commit .env.

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=gb-ansar-db

# AI photo recognition (OpenRouter)
OPENROUTER_API_KEY=

# S3-compatible storage for product photos
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_IDS=
PUBLIC_SITE_URL=
